{
	"name": "@aryrabelo/omp-green-gh",
	"version": "0.1.0",
	"description": "OMP harness extension: the current branch's pull request status in your statusline — is it green, and what is blocking it?",
	"type": "module",
	"license": "MIT",
	"author": "Ary Rabelo",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aryrabelo/omp-green-gh.git"
	},
	"homepage": "https://github.com/aryrabelo/omp-green-gh#readme",
	"bugs": {
		"url": "https://github.com/aryrabelo/omp-green-gh/issues"
	},
	"keywords": [
		"omp",
		"oh-my-pi",
		"pi",
		"extension",
		"plugin",
		"github",
		"pull-request",
		"status-bar",
		"coding-agent"
	],
	"omp": {
		"extensions": [
			"./src/main.ts"
		]
	},
	"engines": {
		"bun": ">=1.0.0"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "^16.0.0",
		"@oh-my-pi/pi-tui": "^16.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@oh-my-pi/pi-coding-agent": "^18.0.11",
		"@oh-my-pi/pi-tui": "^16.4.8",
		"@types/bun": "^1.3.0",
		"@types/node": "^22",
		"typescript": "^5.6.0"
	}
}
